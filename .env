[DATABASE]
TYPE=mysql
HOSTNAME=127.0.0.1
DATABASE=film_cms
USERNAME=root
PASSWORD=root
HOSTPORT=3306
PREFIX=kp_
CHARSET=utf8mb4
DEBUG=true

[SPIDER]
# 目标站点形态：maccms=苹果CMS资源API
TARGET=maccms
# 苹果CMS资源站域名（不含末尾斜杠），请替换为真实可访问的资源站
MACCMS_API_BASE=https://api.example-maccms.com
# 资源接口路径（通常为 /api.php/provide/vod，部分站为 /inc/api.php 等）
MACCMS_API_PATH=/api.php/provide/vod
# 增量采集：仅采集最近 N 小时内更新的影片；0=全量采集
MACCMS_COLLECT_HOURS=0
# 指定采集的分类 type_id 列表（逗号分隔，空=全部）
MACCMS_TYPE_IDS=
# 指定采集的影片 vod_id 列表（逗号分隔，空=按分页/增量）
MACCMS_IDS=

# 抓取并发与限速（防封）
SPIDER_PAGE_SIZE=20
SPIDER_MAX_PAGES=0
SPIDER_CONCURRENCY=4
SPIDER_REQUEST_TIMEOUT=30
SPIDER_RETRY_TIMES=3
SPIDER_RETRY_BACKOFF=2.0
SPIDER_REQUEST_INTERVAL=1.0
SPIDER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
# 代理：http/https 代理地址，空=不使用
SPIDER_PROXY=

# 图片下载
IMAGE_DOWNLOAD=true
# 规范①：封面图片统一存储目录（不存在时自动递归创建）
IMAGE_BASE_DIR=D:\phpstudy_pro\WWW\FilmCms\public\static\images\film-cover
# 规范②：数据库图片地址统一路径前缀 /static/images/film-cover/<影视标题拼音>.jpg
IMAGE_PUBLIC_PREFIX=/static/images/film-cover
IMAGE_TIMEOUT=30
IMAGE_CONCURRENCY=4
IMAGE_MAX_SIZE=10
IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# 运行日志与状态
LOG_LEVEL=INFO
LOG_DIR=runtime/spider/log
STATE_DIR=runtime/spider/state

# ============================================================
# [MOFAGUO] 目标站点（魔法国/欧克TV，苹果CMS-STUI 模板）抓取配置
# 数据库连接信息一律读取上方 [DATABASE]，本段只放站点与抓取策略配置
# ============================================================
[MOFAGUO]
# 目标站点根路径（用户指定为 https://www.mofaguo.cn/gangju/，不含末尾斜杠）
# 所有列表/详情/播放/图片相对地址都以 /gangju/... 开头，由代码用 urljoin 拼接
BASE_URL=https://www.mofaguo.cn/gangju

# 抓取的分类： 本地 type 枚举 -> 站点 news 列表 type 编号
#   movie=电影(1)  tv=电视剧(2)  variety=综艺(3)  anime=动漫(4)
# 多个用英文逗号分隔；留空=抓取全部已知分类
CATEGORIES=movie:1,tv:2,variety:3,anime:4

# 列表页 URL 模板：{type}=站点 type 编号，{page}=页码（page>=2 才带 -page）
LIST_URL_TPL=/gangju/news/{type}.html
LIST_URL_PAGE_TPL=/gangju/news/{type}-{page}.html

# 详情页 / 播放页 URL 模板（{id}=影片数字 id）
DETAIL_URL_TPL=/gangju/news/dt/{id}.html
VIEW_URL_TPL=/gangju/view/{id}-{src}-{ep}.html

# 是否深入 /view/ 页面提取真实直链(m3u8/mp4)。false=只存 /view/ 播放页地址
EXTRACT_PLAY_URL=true
# 单片最多提取的分集直链数（0=不限制）；防封与耗时保护
MAX_EPISODES_PER_FILM=0
# 单片详情抓取失败时最大重试
DETAIL_RETRY_TIMES=3

# 去重主键：source_url（详情页地址作为外部唯一标识，做 upsert）
DEDUP_KEY=source_url
# 增量：仅处理更新时间晚于此小时数的影片（0=全量）
SINCE_HOURS=0

# 分类ID映射（本地 type 枚举 -> ba_film_category 顶层 id），与数据库已有一致
CATEGORY_ID_MAP=movie:1,tv:2,anime:3,documentary:4,variety:5

# ============================================================
# [UPDATE] 资源全量更新模式配置
# 独立于新增采集(run.py)，用于更新库内已有影视资源的关联元数据
# 运行：python run_update.py [--mode full|incremental] [--since-hours N] ...
# ============================================================
[UPDATE]
# 更新子模式：full=全量更新；incremental=增量更新（仅刷新超过时间窗的旧资源）
UPDATE_MODE=full
# 增量窗口小时数（仅 incremental 生效）
UPDATE_SINCE_HOURS=24
# 单资源最大重试次数（需求：最多 3 次）
UPDATE_MAX_RETRY=3
# 单次运行最多处理条数（0=不限制；避免对数据库造成过大写入压力）
UPDATE_LIMIT=0
# 资源状态筛选：1=正常 0=下架（空=全部）
UPDATE_STATUS=
# 类型筛选：movie,tv,variety,anime,documentary（空=全部）
UPDATE_TYPES=
